# Python
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# LaTeX build artifacts
notes/*.aux
notes/*.log
notes/*.out
notes/*.toc
notes/*.fls
notes/*.fdb_latexmk
notes/*.synctex.gz
notes/_minted-*/
notes/*.bbl
notes/*.blg
notes/_minted/

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp
*~

# Build scratch
.build/

# Sources internes de generation des notebooks
# (utilisees uniquement pour regenerer les .ipynb depuis Python)
_build/

# Quarto build artifacts
# Le site est build automatiquement par GitHub Actions et publie sur la
# branche gh-pages (voir .github/workflows/quarto-publish.yml). Aucun
# fichier rendu n'est commit sur main.
docs/
.quarto/
_freeze/
*_files/
*.html
!index.html              # exception : si jamais on a un index.html source

/.quarto/
**/*.quarto_ipynb
