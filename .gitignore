# Python
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# LaTeX build artifacts
notes/*.aux
notes/*.log
notes/*.out
notes/*.toc
notes/*.fls
notes/*.fdb_latexmk
notes/*.synctex.gz
notes/_minted-*/
notes/*.bbl
notes/*.blg
notes/_minted/

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp
*~

# Build scratch
.build/

# Sources internes de generation des notebooks
# (utilisees uniquement pour regenerer les .ipynb depuis Python)
_build/

# Quarto build artifacts (le dossier docs/ est commit pour GitHub Pages)
.quarto/
*_files/
*.html
!docs/**/*.html
# Note : on garde docs/ commit pour Pages, mais .quarto/ (cache) est ignore.

/.quarto/
**/*.quarto_ipynb
